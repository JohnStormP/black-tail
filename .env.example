# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Local demo (Docker Compose):
#   cp .env.example .env
#   make up && make demo
#
# Values below target the Compose network (service hostnames).
# For PHP on the host (symfony serve / host PHPUnit), put overrides in .env.local:
#   DATABASE_URL=postgresql://blacktail:blacktail@127.0.0.1:5432/blacktail?serverVersion=16&charset=utf8
#   REDIS_URL=redis://127.0.0.1:6379
#   CLICKHOUSE_HOST=127.0.0.1
#   CLICKHOUSE_PORT=8124
#   MESSENGER_TRANSPORT_DSN=amqp://guest:guest@127.0.0.1:5672/%2f/messages
#   MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-for-local-demo
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> black-tail/docker ###
# Compose service hostnames (php container). Host ports: Postgres 5432, Redis 6379, ClickHouse 8124.
DATABASE_URL="postgresql://blacktail:blacktail@postgres:5432/blacktail?serverVersion=16&charset=utf8"
REDIS_URL=redis://redis:6379
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=blacktail
CLICKHOUSE_USER=blacktail
CLICKHOUSE_PASSWORD=blacktail
###< black-tail/docker ###

###> symfony/messenger ###
# Choose one of the transports below
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
#MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mercure-bundle ###
# Internal URL (PHP container → mercure service)
MERCURE_URL=http://mercure/.well-known/mercure
# Browser / host machine URL
MERCURE_PUBLIC_URL=http://127.0.0.1:3000/.well-known/mercure
# Must match MERCURE_*_JWT_KEY in docker-compose.yml
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
MERCURE_JWT_ISSUER=https://localhost
###< symfony/mercure-bundle ###

###> black-tail/payments ###
# HMAC-SHA256 of raw webhook body; send as header X-Signature
# Empty secret rejects all webhooks (fail-closed).
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret
###< black-tail/payments ###

###> black-tail/ai ###
# OpenAI-compatible Chat Completions. Empty URL or key → FakeLlmClient (demo / tests).
# Both URL and key set → HttpOpenAiCompatibleLlmClient (works with OpenAI or Gemini OpenAI-compat).
# Put secrets in .env.local (not committed). For Docker Compose, export before up so php gets them:
#   set -a && . ./.env.local && set +a && docker compose up -d php --force-recreate
# Gemini example (model ids change; see ai.google.dev/gemini-api/docs/openai):
#   AI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_LLM_API_KEY=your-gemini-api-key
#   AI_LLM_MODEL=gemini-3.5-flash-lite
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini
AI_ASK_RATE_LIMIT=10
###< black-tail/ai ###
